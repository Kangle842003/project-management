extends ../../layouts/auth.pug

include ../../mixins/alert.pug

block main

  +success-flash(4000)
  +error-flash(4000)

  .card.shadow

    .card-body.p-4

      h2.text-center.mb-4 Đăng nhập Admin

      form(
        action=`${prefixAdmin}/auth/login`
        method="POST"
      )

        .mb-3
          label.form-label(for="email") Email
          input.form-control(
            type="email"
            id="email"
            name="email"
            placeholder="Nhập email"
            required
          )

        .mb-3
          label.form-label(for="passWord") Mật khẩu
          input.form-control(
            type="password"
            id="passWord"
            name="passWord"
            placeholder="Nhập mật khẩu"
            required
          )

        button.btn.btn-primary.w-100(type="submit")
          | Đăng nhập