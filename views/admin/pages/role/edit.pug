extends ../dashboard/index.pug
include ../../mixins/alert.pug
block main
  +error-flash(4000)
  +success-flash(4000)
  .container.mt-4
    .card.shadow-sm.border-0
      .card-header.bg-primary.text-white
        h4.mb-0 Chinh sua nhom quyen

      .card-body
        form(
          action=`${prefixAdmin}/roles/edit/${data.id}?_method=PATCH`
          method="POST"
        )
          .mb-3
            label.form-label(for="title") TIÊU ĐỀ
            input.form-control(
              id="title"
              name="title"
              type="text"
              placeholder="Nhập tiêu đề danh mục..."
              required
              value = data.title
            )
          .mb-3
            label.form-label(for="desc") MÔ TẢ
            textarea.form-control(
              id="desc"
              name="description"
              rows="4"
              placeholder="Nhập mô tả danh mục ..."
              class ="timymce"
            ) #{data.description}
          button.btn.btn-primary.me-2(type="submit") CHINH SUA
          
          a.btn.btn-outline-secondary(
            href=`${prefixAdmin}/roles`
          )
            i.fa-solid.fa-arrow-left.me-2
            | QUAY LẠI

  script(src="/tinymce/tinymce.min.js") 
  script(src="/admin/js/tinymce-config.js") 