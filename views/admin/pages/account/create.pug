extends ../../layouts/default.pug
include ../../mixins/alert.pug
block main
  if(roleAccount.permissions.includes("account_create"))
    +success-flash(4000)
    +error-flash(4000)
    .card
      .card-header
        h3.mb-0 Tạo mới tài khoản
      .card-body
        form(
          action=`${prefixAdmin}/accounts/create`
          method="POST"
          enctype="multipart/form-data"
        )

          // Tên tài khoản
          .mb-3
            label.form-label(for="fullName") Tên tài khoản
            input.form-control(
              type="text"
              id="fullName"
              name="fullName"
              placeholder="Nhập tên tài khoản"
              required
            )

          // Email
          .mb-3
            label.form-label(for="email") Email
            input.form-control(
              type="email"
              id="email"
              name="email"
              placeholder="Nhập email"
              required
            )

          // Mật khẩu
          .mb-3
            label.form-label(for="password") Mật khẩu
            input.form-control(
              type="password"
              id="password"
              name="passWord"
              placeholder="Nhập mật khẩu"
              required
            )

          // Số điện thoại
          .mb-3
            label.form-label(for="phone") Số điện thoại
            input.form-control(
              type="text"
              id="phone"
              name="phone"
              placeholder="Nhập số điện thoại"
            )

          // Ảnh đại diện
          .mb-3(upload-preview)
            label.form-label(for="avatar") ĐƯỜNG DẪN ẢNH
            input.form-control(
              id="avatar"
              name="avatar"
              type="file"
              accept ="image/*"
              placeholder="Nhập đường dẫn ảnh ...."
              upload-preview-input
            )
            img(
              src="" 
              upload-preview-img
              class = "preview-img"
            )
            button(
                  type="button"
                  class = "btn btn-secondary close-preview"
                  close-preview-image="false"
                ) Xoa Anh

          // Phân quyền
          .mb-3
            label.form-label(for="role_id") Phân quyền
            select.form-select(
              id="role_id"
              name="role_id"
            )
              option(value="") -- Chọn nhóm quyền --
              each item in roles
                option(
                  value=item._id
                )= item.title

          // Trạng thái
          .mb-3
            label.form-label Trạng thái hoạt động

            .form-check
              input.form-check-input(
                type="radio"
                name="status"
                id="active"
                value="active"
                checked
              )
              label.form-check-label(for="active")
                | Hoạt động

            .form-check
              input.form-check-input(
                type="radio"
                name="status"
                id="inactive"
                value="inactive"
              )
              label.form-check-label(for="inactive")
                | Dừng hoạt động

          .mt-4
            button.btn.btn-primary(
              type="submit"
            )
              i.fa-solid.fa-floppy-disk.me-1
              | Tạo tài khoản

            a.btn.btn-secondary.ms-2(
              href=`${prefixAdmin}/accounts`
            )
              | Quay lại
