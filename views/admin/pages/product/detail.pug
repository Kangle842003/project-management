extends ../../layouts/default.pug

block main
  .container-fluid.py-4
    .card.shadow-sm
      .card-header.d-flex.justify-content-between.align-items-center
        h4.mb-0 Chi tiết sản phẩm

        a.btn.btn-secondary(
          href=`${prefixAdmin}/products`
        )
          i.fa-solid.fa-arrow-left.me-2
          | Quay lại

      .card-body
        .row
          // Image
          .col-md-4
            .border.rounded.p-2
              img.w-100.rounded(
                src=data.thumbnail
                alt=data.title
              )

          // Info
          .col-md-8
            table.table.table-bordered.align-middle
              tbody
                tr
                  th(style="width:220px") ID
                  td= data.id

                tr
                  th Tên sản phẩm
                  td= data.title

                tr
                  th Giá gốc
                  td.text-danger
                    = data.price.toLocaleString("vi-VN") + "$"

                tr
                  th Giảm giá
                  td
                    if(data.discountPercentage > 0)
                      span.badge.bg-danger
                        | #{data.discountPercentage}%
                    else
                      span.badge.bg-secondary 0%
                tr
                  th Tồn kho
                  td
                    if(data.stock > 0)
                      span.badge.bg-success
                        | #{data.stock} sản phẩm
                    else
                      span.badge.bg-danger Hết hàng

                tr
                  th Trạng thái
                  td
                    if(data.status == "active")
                      span.badge.bg-success Hoạt động
                    else
                      span.badge.bg-danger Dừng hoạt động

                tr
                  th Vị trí
                  td= data.position

                tr
                  th Ngày tạo
                  td
                    = new Date(data.createdAt).toLocaleString("vi-VN")

                tr
                  th Ngày cập nhật
                  td
                    = new Date(data.updatedAt).toLocaleString("vi-VN")

        // Description
        .mt-4
          h5.mb-3 Mô tả sản phẩm

          .border.rounded.p-3.bg-light
            != data.description

        // Action
        .mt-4.d-flex.gap-2
          a.btn.btn-warning(
            href=`${prefixAdmin}/products/edit/${data.id}`
          )
            i.fa-solid.fa-pen.me-2
            | Chỉnh sửa