extends ../dashboard/index.pug
include ../../mixins/alert.pug

block main
  +error-flash(5000)
  .container.mt-4
    .card.shadow-sm.border-0
      .card-header.bg-primary.text-white
        h4.mb-0 Chinh sua san pham

      .card-body
        form(
          action=`${prefixAdmin}/products/edit/${data.id}?_method=PATCH`
          method="POST"
          enctype="multipart/form-data"
        )

          .mb-3
            label.form-label(for="title") TIÊU ĐỀ
            input.form-control(
              id="title"
              name="title"
              type="text"
              placeholder="Nhập tiêu đề sản phẩm..."
              required
              value = data.title
            )

          .mb-3
            label.form-label(for="desc") MÔ TẢ
            textarea.form-control(
              id="desc"
              name="description"
              rows="4"
              placeholder="Nhập mô tả sản phẩm ..."
              class = "timymce"
            ) #{data.description}

          .mb-3
            label.form-label(for="price") GIÁ
            input.form-control(
              id="price"
              name="price"
              type="number"
              value = data.price
            )

          .mb-3
            label.form-label(for="discountPercentage") % GIẢM GIÁ
            input.form-control(
              id="discountPercentage"
              name="discountPercentage"
              type="number"
              value = data.discountPercentage
            )

          .mb-3
            label.form-label(for="stock") SỐ LƯỢNG
            input.form-control(
              id="stock"
              name="stock"
              type="number"
              value = data.stock
              min = 1
            )
          
          .mb-3(upload-preview)
            label.form-label(for="img") ĐƯỜNG DẪN ẢNH
            input.form-control(
              id="img"
              name="thumbnail"
              type="file"
              accept ="image/*"
              placeholder="Nhập đường dẫn ảnh ...."
              upload-preview-input
            )
            img(
              src=data.thumbnail
              upload-preview-img
              class = "preview-img"
            )
            //- button(
            //-   class = "close-preview"
            //-   close-preview-image="false"
            //- ) X
            button(
              type="button"
              class = "btn btn-secondary close-preview"
              close-preview-image="false"
            ) Xoa Anh
          .mb-3
            label.form-label(for="position") VỊ TRÍ
            input.form-control(
              id="position"
              name="position"
              type="number"
              placeholder="Vị trí sẽ tự động tăng nếu không điền ! "
              value = data.position
            )
    
          .mb-4
            label.form-label.d-block TRẠNG THÁI

            .form-check
              input.form-check-input(
                type="radio"
                name="status"
                id="active"
                value="active"
                checked = (data.status == "active" ? true : false)
              )
              label.form-check-label(for="active")
                | Hoạt động

            .form-check
              input.form-check-input(
                type="radio"
                name="status"
                id="inactive"
                value="inactive"
                checked = (data.status == "inactive" ? true : false)
              )
              label.form-check-label(for="inactive")
                | Dừng hoạt động

          button.btn.btn-primary.me-2(type="submit") CHINH SUA 

          a.btn.btn-outline-secondary(
            href=`${prefixAdmin}/products`
          )
            i.fa-solid.fa-arrow-left.me-2
            | QUAY LẠI

  script(src="/tinymce/tinymce.min.js") 
  script(src="/admin/js/tinymce-config.js") 
  script(src="/admin/js/product.js") 