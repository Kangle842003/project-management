extends ../../layouts/default.pug
include ../../mixins/filter-status.pug
include ../../mixins/search.pug
include ../../mixins/pagination.pug
block main
  h1 Trang danh sach san pham
  .card.mb-3 
    .card-header Bo loc va tim kiem 
    .card-body 
      .row 
        .col-8 
          +filter-status(filterStatus)      
    
        .col-4
          +search(keyword)
        
        
  .card.mb-3 
    .card-header danh sach san pham
    .card-body 
      table.table.table-bordered.table-hover.align-middle
          thead.table-primary
            tr
              th STT
              th Hình ảnh
              th Tiêu đề
              th Giá
              th Trạng thái
              th Hành động

          tbody
            each item,index in data
              tr
                td #{index +1}
                td
                  img(
                    src=item.thumbnail
                    alt = item.title
                    width="80"
                    height="80"
                  )
                td #{item.title}
                td.text-danger.fw-bold #{item.price} $
                td
                  if(item.status == "active")
                    button(
                      class="badge bg-success"
                      data-id = item._id
                      button-change-status = item.status
                      ) Hoạt động
                  else 
                    button(
                      class="badge bg-danger"
                      data-id = item._id
                      button-change-status = item.status
                      ) Dừng hoạt động
                td
                  a.btn.btn-sm.btn-info.me-1(href="#")
                    | Sửa
                  a.btn.btn-sm.btn-danger(href="#")
                    | Xóa
  +pagination(objectPagination, pages)
  
  //form-change-status
  form(
    action=""
    method="POST"
    id="form-change-status"
    data-path = `${prefixAdmin}/products/change-status`) 

  script(src="/admin/js/product.js") 
