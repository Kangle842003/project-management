extends ../../layouts/default.pug
block main
  h1 danh sach san pham

  table.table.table-bordered.table-hover.align-middle
      thead.table-primary
        tr
          th STT
          th Hình ảnh
          th Tiêu đề
          th Giá
          th Trạng thái
          th Hành động

      tbody
        each item,index in data
          tr
            td #{index +1}
            td
              img(
                src=item.thumbnail
                alt = item.title
                width="80"
                height="80"
              )
            td #{item.title}
            td.text-danger.fw-bold #{item.price} $
            td
              if(item.status == "active")
                span.badge.bg-success Hoạt động
              else 
                span.badge.bg-danger Dung Hoạt động
            td
              a.btn.btn-sm.btn-info.me-1(href="#")
                | Sửa
              a.btn.btn-sm.btn-danger(href="#")
                | Xóa
