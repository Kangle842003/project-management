extends ../../layouts/default.pug
include ../../mixins/filter-status.pug
include ../../mixins/search.pug
block main
  h1 Trang danh sach san pham
  .card.mb-3 
    .card-header Bo loc va tim kiem 
    .card-body 
      .row 
        .col-8 
          +filter-status(filterStatus)      
    
        .col-4
          +search(keyword)
        
        
  .card.mb-3 
    .card-header danh sach san pham
    .card-body 
      table.table.table-bordered.table-hover.align-middle
          thead.table-primary
            tr
              th STT
              th Hình ảnh
              th Tiêu đề
              th Giá
              th Trạng thái
              th Hành động

          tbody
            each item,index in data
              tr
                td #{index +1}
                td
                  img(
                    src=item.thumbnail
                    alt = item.title
                    width="80"
                    height="80"
                  )
                td #{item.title}
                td.text-danger.fw-bold #{item.price} $
                td
                  if(item.status == "active")
                    span.badge.bg-success Hoạt động
                  else 
                    span.badge.bg-danger Dung Hoạt động
                td
                  a.btn.btn-sm.btn-info.me-1(href="#")
                    | Sửa
                  a.btn.btn-sm.btn-danger(href="#")
                    | Xóa
  nav   
    ul(class ="pagination")
      if (objectPagination.currentPage > 1)
        li(class ="page-item")
          button(
            class="page-link"
            button-page = objectPagination.currentPage - 1
            ) Back
      - for (let i = 1 ; i<=pages ; i++)
          li(class=`page-item ${objectPagination.currentPage == i ? "active" : ""}`)
            button(
              class="page-link"
            button-page = i
              ) #{i}
      if (objectPagination.currentPage < pages)
        li(class ="page-item")
          button(
            class="page-link"
          button-page = objectPagination.currentPage + 1
            ) Next

