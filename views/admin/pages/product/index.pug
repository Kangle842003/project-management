extends ../../layouts/default.pug
block main
  h1 Trang danh sach san pham
  .card.mb-3 
    .card-header Bo loc va tim kiem 
    .card-body 
      .row 
        .col-8       
          each item in filterStatus
            button(
              class = `btn btn-sm ml-1 btn-outline-success ${item.class}`
              button-status = item.status
            ) #{item.name}
        .col-4
          form(id="form-search")
            input.form-control(
              type="text"
              name="keyword"
              placeholder="Nhập từ khóa..."
              value = keyword
            )
            button.btn.btn-primary(
              type="submit"
            ) Tìm kiếm
        
        
  .card.mb-3 
    .card-header danh sach san pham
    .card-body 
      table.table.table-bordered.table-hover.align-middle
          thead.table-primary
            tr
              th STT
              th Hình ảnh
              th Tiêu đề
              th Giá
              th Trạng thái
              th Hành động

          tbody
            each item,index in data
              tr
                td #{index +1}
                td
                  img(
                    src=item.thumbnail
                    alt = item.title
                    width="80"
                    height="80"
                  )
                td #{item.title}
                td.text-danger.fw-bold #{item.price} $
                td
                  if(item.status == "active")
                    span.badge.bg-success Hoạt động
                  else 
                    span.badge.bg-danger Dung Hoạt động
                td
                  a.btn.btn-sm.btn-info.me-1(href="#")
                    | Sửa
                  a.btn.btn-sm.btn-danger(href="#")
                    | Xóa
