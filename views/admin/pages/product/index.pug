extends ../../layouts/default.pug
include ../../mixins/filter-status.pug
include ../../mixins/search.pug
include ../../mixins/pagination.pug
include ../../mixins/form-change-multi.pug
block main
  h1 Trang danh sach san pham
  .card.mb-3 
    .card-header Bo loc va tim kiem 
    .card-body 
      .row 
        .col-8 
          +filter-status(filterStatus)      
    
        .col-4
          +search(keyword)
      

  .card.mb-3 
    .card-header DANH SACH SAN PHAM
      +form-change-multi()
    .card-body 
      table(
        class ="table table-bordered table-hover align-middle"
        form-multi
      )
          thead.table-primary
            tr
              th 
                input(type="checkbox" check-box-all)
              th STT
              th Hình ảnh
              th Tiêu đề
              th Vị trí
              th Giá
              th Trạng thái
              th Hành động

          tbody
            each item,index in data
              
              tr
                td 
                  input(type ="checkbox" check-box-item value = item.id)
                td #{index +1}
                td
                  img(
                    src=item.thumbnail
                    alt = item.title
                    width="80"
                    height="80"
                  )
                td #{item.title}
                td 
                  input(
                    name = "position"
                    type ="number"
                    value = item.position
                    min = 1
                    class="form-control w-25"
                    required
                  )
                td.text-danger.fw-bold #{item.price} $
                td
                  if(item.status == "active")
                    button(
                      class="badge bg-success"
                      data-id = item._id
                      button-change-status = item.status
                      ) Hoạt động
                  else 
                    button(
                      class="badge bg-danger"
                      data-id = item._id
                      button-change-status = item.status
                      ) Dừng hoạt động
                td
                  button(
                    class = "btn btn-sm btn-info me-1"
                    
                  ) Sửa
                  button(
                    class = "btn btn-sm btn-danger"
                    button-delete-item
                    data-id = item.id
                  ) Xóa
                  
  +pagination(objectPagination, pages)

  //form-change-status
  form(
    action=""
    method="POST"
    id="form-change-status"
    data-path = `${prefixAdmin}/products/change-status`) 

  //form-delete-item
  form(
    action="" 
    method="POST"
    id="form-delete-item-product"
    path=`${prefixAdmin}/products/delete`)

  script(src="/admin/js/product.js") 
