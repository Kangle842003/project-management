mixin form-change-multi ()
  form(
    id="form-change-multi"
    action=`${prefixAdmin}/products/change-multi?_method=PATCH`
    method="POST"
  )
    select(
      name="type"
      )
      option(  value="" selected disabled) -- Chọn hành động --
      option(  value = "active") Hoat dong
      option(  value = "inactive") Dung hoat dong
      option(  value = "deleteAll") Xoa tat ca
      option(  value = "change-position") Thay doi vi tri
    input(
      type="text"
      name="ids"
      input-ids
      class="d-none"
    )
    button(
      class="badge bg-success"
      type="submit"
      ) Ap dung