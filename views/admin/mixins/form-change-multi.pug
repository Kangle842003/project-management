mixin form-change-multi (action)
  form(
    id="form-change-multi"
    action = action 
    method="POST"
  )
    select(
      name="type"
      )
      option(  value="" selected disabled) -- Chọn hành động --
      option(  value = "active") HOẠT ĐỘNG
      option(  value = "inactive") DỪNG HOẠT ĐỘNG
      option(  value = "deleteAll") XÓA TẤT CẢ
      option(  value = "change-position") THAY ĐỔI VỊ TRÍ
    input(
      type="text"
      name="ids"
      input-ids
      class="d-none"
    )
    button(
      class="badge bg-success"
      type="submit"
      ) ÁP DỤNG